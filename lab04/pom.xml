<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>psu.se411</groupId>
  <artifactId>fintech</artifactId>
  <version>0.0.1-SNAPSHOT</version>

  <!-- Exercise 2: project information -->
  <name>FinTech</name>
  <description>FinTech — course main project for SE411 Software Construction (section 1383).
    Maven project wired up with JavaFX and the Maven Site plugin.</description>
  <url>https://github.com/IbrahimH05/se411_labs</url>

  <licenses>
    <license>
      <name>Apache License 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <organization>
    <name>SE411-Tech-Company</name>
    <url>https://github.com/IbrahimH05</url>
  </organization>

  <developers>
    <developer>
      <name>Ibrahim Alhalaki</name>
      <email>ibrahimalhalakicollege@gmail.com</email>
      <organization>SE411-Tech-Company</organization>
      <roles>
        <role>developer</role>
      </roles>
    </developer>
  </developers>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>23</javafx.version>
  </properties>

  <!-- Exercise 1: JavaFX dependency -->
  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Exercise 1: JavaFX plugin providing the run goal -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>psu.se411.fintech.MainClass</mainClass>
        </configuration>
      </plugin>

      <!-- Exercise 2: Maven Site plugin -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-site-plugin</artifactId>
        <version>3.21.0</version>
      </plugin>
    </plugins>
  </build>

  <!-- Exercise 2: reports rendered into the generated site -->
  <reporting>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-project-info-reports-plugin</artifactId>
        <version>3.9.0</version>
      </plugin>
    </plugins>
  </reporting>
</project>
